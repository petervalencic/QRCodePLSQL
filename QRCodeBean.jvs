CREATE OR REPLACE AND RESOLVE JAVA SOURCE NAMED "QRCodeBean" AS
import oracle.sql.BLOB;
import oracle.jdbc.driver.OracleDriver;
import java.io.ByteArrayOutputStream;
import java.io.OutputStream;
import java.sql.Connection;
import net.glxn.qrgen.QRCode;
import net.glxn.qrgen.image.ImageType;

public class QRCodeGenerator {

    static OracleDriver ora = new OracleDriver();
    static Connection conn;

    static {
        try {
            conn = ora.defaultConnection();
        } catch (Exception ex) {
            // Ignored
        }
    }

    public static BLOB getQrCode(String value) throws Exception {
        if (conn == null || conn.isClosed()) {
            conn = ora.defaultConnection();
        }

        BLOB retBlob = BLOB.createTemporary(conn, true, BLOB.DURATION_SESSION);

        // Fix: Use try-with-resources to close out and outStr automatically
        try (ByteArrayOutputStream out = QRCode.from(value).to(ImageType.GIF).stream();
             OutputStream outStr = retBlob.setBinaryStream(1L)) { // 1L is 1-based index for SQL LOBs
            
            out.writeTo(outStr);
            outStr.flush();
        }

        return retBlob;
    }
}
