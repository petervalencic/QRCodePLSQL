CREATE OR REPLACE AND RESOLVE JAVA SOURCE NAMED "QRCodeBean" AS
import oracle.sql.BLOB;
import oracle.jdbc.driver.*;
import java.sql.*;
import java.io.*;
import java.util.*;
import net.glxn.qrgen.QRCode;
import net.glxn.qrgen.image.ImageType;

public class QRCodeGenerator {

    public static BLOB getQrCode(String value, String imageType) throws Exception {
        Connection conn = null;
        BLOB retBlob = null;
        ByteArrayOutputStream out = null;
        try {
            conn = DriverManager.getConnection("jdbc:oracle:thin:@<host>:<port>:<sid>", "<user>", "<password>");
            retBlob = BLOB.createTemporary(conn, true, oracle.sql.BLOB.DURATION_SESSION);
            out = QRCode.from(value).to(ImageType.valueOf(imageType.toUpperCase())).stream();

            try (OutputStream outStr = retBlob.setBinaryStream(0)) {
                outStr.write(out.toByteArray());
            }
        } catch (SQLException | IOException ex) {
            // Handle exceptions appropriately (e.g., log the error)
            throw ex; 
        } finally {
            try {
                if (out != null) {
                    out.close();
                }
                if (conn != null) {
                    conn.close();
                }
            } catch (SQLException ex) {
                // Handle connection closing exception
            }
        }
        return retBlob;
    }
}
